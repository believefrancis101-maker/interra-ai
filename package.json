{
  "name": "interra-ai",
  "version": "1.0.0",
  "description": "Interra AI — AI-Powered Job Description Analysis & Interview Prep",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "worker": "tsx watch src/worker/index.ts",
    "start": "tsx src/app/server.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test src/lib/call-model.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.104.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
